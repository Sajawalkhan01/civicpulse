DATABASE_URL=postgresql://civicpulse:123456789@localhost:5433/civicpulse  # Postgres connection string used by the backend
POSTGRES_USER=civicpulse                                                 # Postgres user created by the Postgres container
POSTGRES_PASSWORD=123456789                                                # Postgres password (never a real secret in this file)
POSTGRES_DB=civicpulse                                                    # Postgres database name created by the Postgres container
REDIS_URL=redis://localhost:6379/0                                        # Redis connection string used for caching/rate limiting
TRIAGE_PROVIDER=simulated                                                 # rules | simulated | llm | ollama
GROQ_API_KEY=changeme                                                     # API key for the Groq LLM provider (never a real secret in this file)
GROQ_MODEL=openai/gpt-oss-20b                                             # Groq model identifier used for triage requests
OLLAMA_BASE_URL=http://ollama:11434                                       # Local/self-hosted Ollama HTTP endpoint
OLLAMA_MODEL=llama3.2:1b                                                  # Ollama model identifier used for triage requests
RATE_LIMIT_PER_MINUTE=60                                                  # Max requests per minute allowed per client
CORS_ORIGINS=http://localhost:5173                                       # Comma-separated list of allowed CORS origins
LOG_LEVEL=INFO                                                            # Application log verbosity (DEBUG/INFO/WARNING/ERROR)
IMAGE_TAG=dev                                                             # Docker image tag used when building/deploying
